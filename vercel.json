{
  "trailingSlash": true,
  "headers": [
    {
      "source": "/assets/hx/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/vendor/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    },
    {
      "source": "/posters/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/w/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/factory/assets/hx/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/factory/vendor/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    },
    {
      "source": "/factory/posters/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/factory/w/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/factory/api/:fn/",
      "destination": "/api/:fn"
    },
    {
      "source": "/factory/api/:fn",
      "destination": "/api/:fn"
    },
    {
      "source": "/factory",
      "destination": "/index.html"
    },
    {
      "source": "/factory/",
      "destination": "/index.html"
    },
    {
      "source": "/factory/:a/",
      "destination": "/:a/index.html"
    },
    {
      "source": "/factory/:a/:b/",
      "destination": "/:a/:b/index.html"
    },
    {
      "source": "/factory/:path*",
      "destination": "/:path*"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "hanflux-design-menu.vercel.app"
        }
      ],
      "destination": "https://hanflux.ai/factory/",
      "permanent": false
    },
    {
      "source": "/websites/",
      "has": [
        {
          "type": "host",
          "value": "hanflux-design-menu.vercel.app"
        }
      ],
      "destination": "https://hanflux.ai/factory/websites/",
      "permanent": false
    },
    {
      "source": "/websites/:a/",
      "has": [
        {
          "type": "host",
          "value": "hanflux-design-menu.vercel.app"
        }
      ],
      "destination": "https://hanflux.ai/factory/websites/:a/",
      "permanent": false
    },
    {
      "source": "/order/",
      "has": [
        {
          "type": "host",
          "value": "hanflux-design-menu.vercel.app"
        }
      ],
      "destination": "https://hanflux.ai/factory/order/",
      "permanent": false
    },
    {
      "source": "/websites/:path*",
      "has": [
        {
          "type": "host",
          "value": "hanflux-design-menu.vercel.app"
        }
      ],
      "destination": "https://hanflux.ai/factory/websites/:path*",
      "permanent": false
    },
    {
      "source": "/order/:path*",
      "has": [
        {
          "type": "host",
          "value": "hanflux-design-menu.vercel.app"
        }
      ],
      "destination": "https://hanflux.ai/factory/order/:path*",
      "permanent": false
    }
  ]
}